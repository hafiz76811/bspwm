#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# PS1='[\u@\h \W]\$ ' # archlinux full_white
# PS1='\[\e[1;36m\]┌──(\[\e[1;34m\]\u@\h\[\e[1;36m\])─[\[\033[00m\]\w\[\e[1;36m\]]\n└──\[\e[1;34m\]\$\[\e[0m\] ' # kali_linux lightblue
PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ ' # debian green_blue
# PS1='${debian_chroot:+($debian_chroot)}\[\033[01;33m\]\u@\h\[\033[00m\]:\[\033[01;32m\]\w\[\033[00m\]\$ ' # ubuntu orange_green

alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias lr='tree'

alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias dir='dir --color=auto'
alias vdir='vdir --color=auto'

alias cpr='cp -r'
alias rmr='rm -r'

alias ..='cd ..'
alias ...='cd ../..'

alias rm='trash-put'
alias fastfetch='fastfetch --config none'

source ~/.config/bash/git
source ~/.config/bash/create.sh
