[global]
monitor = 0
follow = mouse

height = (90, 300)
offset = (12, 54)
separator_height = 3
corner_radius = 6
font = Adwaita Sans 11
# line_height = 4

origin = top-right
notification_limit = 3
markup = full
format = <b>%s</b>\n%b
show_age_threshold = 10
word_wrap = yes
min_icon_size = 32
max_icon_size = 130
icon_theme = Adwaita
enable_recursive_icon_lookup = true

timeout = 5

[urgency_low]
timeout = 3
background = "#282a2e"
foreground = "#ffffff"
frame_color = "#84b4ee"

[urgency_normal]
timeout = 5
background = "#282a2e"
foreground = "#ffffff"
frame_color = "#f5cf5f"

[urgency_critical]
timeout = 0
background = "#282a2e"
foreground = "#ffffff"
frame_color = "#ff6f6f"
